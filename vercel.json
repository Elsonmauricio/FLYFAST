{
  "version": 2,
  "builds": [
    {
      "src": "flyfast-backend/package.json",
      "use": "@vercel/node",
      "config": {
        "distDir": "."
      }
    },
    {
      "src": "flyfast-frontend/package.json",
      "use": "@vercel/static-build",
      "config": { 
        "distDir": "build" 
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/flyfast-backend"
    },
    {
      "src": "/static/(.*)",
      "dest": "/flyfast-frontend/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/flyfast-frontend/index.html"
    }
  ]
}