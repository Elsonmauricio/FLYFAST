{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/flyfast-backend/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/flyfast-frontend/index.html"
    }
  ],
  "functions": {
    "flyfast-backend/index.js": {
      "maxDuration": 10
    }
  }
}