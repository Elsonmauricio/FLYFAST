{
  "version": 2,
  "builds": [
    {
      "src": "flyfast-backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "flyfast-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/flyfast-backend/index.js"
    },
    {
      "src": "/[^.]+", 
      "dest": "/flyfast-frontend/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}