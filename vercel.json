{
  "version": 2,
  "builds": [
    {
      "src": "flyfast-backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "flyfast-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/flyfast-backend/server.js"
    },
   { "src": "/static/(.*)",
      "dest": "/flyfast-frontend/static/$1"
    },
    {
      "src": "/(.*\\..*)",
      "dest": "/flyfast-frontend/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/flyfast-frontend/index.html"
}
  ]
}